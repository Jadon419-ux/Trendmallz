# ── Replicate (Virtual Try-On) ─────────────────────────────────────────────────
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Session secret (any long random string) ────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string

# ── Snap Kit OAuth (optional) ──────────────────────────────────────────────────
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=https://your-domain.com/auth/snap/callback

# ── Shipbubble (Delivery rates & tracking) ─────────────────────────────────────
# Get from https://app.shipbubble.com/settings/api
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_WEBHOOK_SECRET=

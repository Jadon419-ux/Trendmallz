# ── Replicate (Virtual Try-On) ─────────────────────────────────────────────────
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Session secret (any long random string) ────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string

# ── Snap Kit OAuth (optional) ──────────────────────────────────────────────────
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=https://your-domain.com/auth/snap/callback

# ── Shipbubble (Delivery rates & tracking) ─────────────────────────────────────
# Get from https://app.shipbubble.com/settings/api
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_WEBHOOK_SECRET=

# ── Paystack (Payments) ────────────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
# Use pk_test_/sk_test_ keys while testing, pk_live_/sk_live_ in production
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Resend (verification emails) ───────────────────────────────────────────────
# Get from https://resend.com/api-keys. Without it, signup skips email codes (dev only).
# The default onboarding@resend.dev sender only delivers to your own Resend account email;
# verify trendmallz.com in Resend to send to customers, then set e.g.
# RESEND_FROM=TrendMallz <no-reply@trendmallz.com>
RESEND_API_KEY=
RESEND_FROM=
